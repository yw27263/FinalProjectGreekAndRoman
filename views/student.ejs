<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Greek and Roman Points</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <main class="mainGoofy">
        <!--title-->
        <h1>greek and roman tracker!</h1>
        <div class="contain">
            <!--Points-->
            <div class="section1">
                <div class="col roman">
                    <h3>ROMAN POINTS</h3>
                    <h2><%= romanPoints %></h2>
                </div>

                <div class="col greek">
                    <h3>GREEK POINTS</h3>
                    <h2><%= greekPoints %></h2>
                </div>
            </div>
        </div>
        <div>
            <br>
            <h3 class="winnertext">
                <% if(greekPoints > romanPoints) {%>
                    Greeks are winning!
                <%} else if(romanPoints > greekPoints) {%>
                    Romans are winning!
                <%} else {%>
                    The teams are tied!
                <%}%>
            </h3>
        </div>
            <div class="section2s">
                <a class="as" href="/studentEvents">Events</a>
                <br>
                <a class="as" href="/pointHistory">Point History</a>
                <br>
                <a class="as" href="/login">Login as an Admin</a>
            </div>
            <div id="GRimg"></div>
        </main>
</body>
</html>