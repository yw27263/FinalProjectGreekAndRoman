<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles.css">
    <title>studentEvents</title>
</head>
<body>
    <main>
     <a href="/">Back to Student Page</a>
    <h2>Current Events</h2>

    <section class="event-list">
        <% if (events && events.length > 0) { %>
            <% events.forEach(event => { %>
            <li class="sectionEvent">
                <h3><strong><%= event.name %> </strong> <em>~ (<%= event.date %>)</em></h3>
                </h2><%= event.message %></h2>
            </li>
            <% }) %>
        <% } else { %>
            <li class="no-events-message">No events currently!</li>
        <% } %>
    </section>
    </main>
</body>
</html>

